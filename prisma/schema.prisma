datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Health {
  id        Int      @id @default(autoincrement())
  note      String?
  createdAt DateTime @default(now())
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  role         UserRole   @default(USER)
  createdAt    DateTime   @default(now())
  favorites    Favorite[]
}

enum ProductType {
  CLUTCH_KIT
  DISC
  PRESSURE_PLATE
  RELEASE_BEARING
  FLYWHEEL
  HYDRAULIC_KIT
}

model Product {
  id        Int        @id @default(autoincrement())
  sku       String     @unique
  title     String
  price     Decimal    @db.Decimal(10, 2)
  imageUrl  String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  favorites Favorite[]

  // --- teknik alanlar ---
  type               ProductType @default(CLUTCH_KIT)
  discDiameterMm     Int?
  pressurePlateDiaMm Int?
  splineCount        Int?
  flywheelType       String?
  material           String?

  // --- ilişkiler ---
  compatibilities ProductCompatibility[]
  categories      ProductCategoryMap[]
}

model Favorite {
  userId    Int
  productId Int
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

model Brand {
  id     Int            @id @default(autoincrement())
  name   String         @unique
  models VehicleModel[]
}

model VehicleModel {
  id      Int           @id @default(autoincrement())
  name    String
  brandId Int
  brand   Brand         @relation(fields: [brandId], references: [id])
  years   VehicleYear[]

  @@unique([brandId, name])
}

model VehicleYear {
  id      Int          @id @default(autoincrement())
  year    Int
  modelId Int
  model   VehicleModel @relation(fields: [modelId], references: [id])
  engines EngineSpec[]

  @@unique([modelId, year])
}

model EngineSpec {
  id              Int                    @id @default(autoincrement())
  vehicleYearId   Int
  vehicleYear     VehicleYear            @relation(fields: [vehicleYearId], references: [id])
  code            String?
  fuel            String?
  displacement    Int?
  hp              Int?
  transmission    String?
  compatibilities ProductCompatibility[]
}

model ProductCompatibility {
  productId Int
  engineId  Int
  product   Product    @relation(fields: [productId], references: [id])
  engine    EngineSpec @relation(fields: [engineId], references: [id])

  @@id([productId, engineId])
}

model Category {
  id       Int                  @id @default(autoincrement())
  name     String
  slug     String               @unique
  parentId Int?
  parent   Category?            @relation("CategoryToSelf", fields: [parentId], references: [id])
  children Category[]           @relation("CategoryToSelf")
  maps     ProductCategoryMap[]

  @@unique([parentId, name])
}

model ProductCategoryMap {
  productId  Int
  categoryId Int
  product    Product  @relation(fields: [productId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
}
